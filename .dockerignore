# Build context for infra/docker/*.Dockerfile: the sources, never secrets, dependencies or data.
**/node_modules
**/.venv
**/__pycache__
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/.next
dist
tmp
out-tsc
coverage
.nx
.swc
