# Copy to terraform.tfvars (git-ignored) and fill in. Never put a secret here: state is plain text.
region                        = "ap-south-1"
domain                        = "forexedge.tech"
github_repo                   = "aakash1514/algo_trading_forex"
alert_email                   = "alerts@example.com"
instance_type                 = "t3.medium"
cpu_credits                   = "standard"
instance_state                = "running"
root_volume_gb                = 40
enable_termination_protection = true
