{
  "name": "ml-service",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/ml-service/src",
  "projectType": "application",
  "tags": ["lang:python"],
  "targets": {
    "setup": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/ml-service",
        "command": "node ../../tools/python/run.cjs --setup"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default"],
      "options": {
        "cwd": "apps/ml-service",
        "commands": ["node ../../tools/python/run.cjs -m ruff check .", "node ../../tools/python/run.cjs -m ruff format --check ."],
        "parallel": false
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default"],
      "options": {
        "cwd": "apps/ml-service",
        "command": "node ../../tools/python/run.cjs -m mypy"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", { "env": "RUN_DB_TESTS" }],
      "options": {
        "cwd": "apps/ml-service",
        "command": "node ../../tools/python/run.cjs -m pytest"
      }
    },
    "train": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/ml-service",
        "env": { "PYTHONPATH": "src" },
        "command": "node ../../tools/python/run.cjs -m ml_service.walk_forward"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/ml-service",
        "command": "node ../../tools/python/run.cjs -m uvicorn ml_service.main:create_app --factory --app-dir src --port 3006"
      }
    }
  }
}
