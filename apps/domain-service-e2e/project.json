{
  "name": "domain-service-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "implicitDependencies": ["domain-service"],
  "targets": {
    "e2e": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{e2eProjectRoot}"],
      "options": {
        "jestConfig": "apps/domain-service-e2e/jest.config.cts",
        "passWithNoTests": true
      },
      "dependsOn": ["domain-service:build", "domain-service:serve"]
    }
  }
}
