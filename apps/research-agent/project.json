{
  "name": "research-agent",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/research-agent/src",
  "projectType": "application",
  "tags": ["lang:python"],
  "targets": {
    "setup": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/research-agent",
        "command": "node ../../tools/python/run.cjs --setup"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default"],
      "options": {
        "cwd": "apps/research-agent",
        "commands": ["node ../../tools/python/run.cjs -m ruff check .", "node ../../tools/python/run.cjs -m ruff format --check ."],
        "parallel": false
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default"],
      "options": {
        "cwd": "apps/research-agent",
        "command": "node ../../tools/python/run.cjs -m mypy"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", { "env": "RUN_DB_TESTS" }, { "env": "RUN_LIVE_ML" }, { "env": "EXPECT_NO_LLM_KEY" }],
      "options": {
        "cwd": "apps/research-agent",
        "command": "node ../../tools/python/run.cjs -m pytest"
      }
    },
    "eval": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/research-agent",
        "env": { "PYTHONPATH": "src" },
        "command": "node ../../tools/python/run.cjs -m research_agent.live_eval"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/research-agent",
        "command": "node ../../tools/python/run.cjs -m uvicorn research_agent.main:create_app --factory --app-dir src --port 3007"
      }
    }
  }
}
