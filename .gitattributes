# Normalize line endings: LF in the repo and working tree, CRLF only for Windows scripts.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Model artifacts: never touch their bytes (models/manifest.json pins their sha256)
*.pt binary
*.npz binary

# Recorded official calendar pages: byte for byte as served (their sha256 is in the fixtures README)
apps/domain-service/src/economic-calendar/__fixtures__/*.htm -text
apps/domain-service/src/economic-calendar/__fixtures__/*.html -text
apps/domain-service/src/economic-calendar/__fixtures__/*/*.htm -text
