{
  "compileOnSave": false,
  "compilerOptions": {
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "commonjs",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@forexedge/common": ["./libs/common/src/index.ts"],
      "@forexedge/database": ["./libs/database/src/index.ts"],
      "@forexedge/database/testing": ["./libs/database/src/testing/test-database.ts"],
      "@forexedge/kafka": ["./libs/kafka/src/index.ts"],
      "@forexedge/trading-sim": ["./libs/trading-sim/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
