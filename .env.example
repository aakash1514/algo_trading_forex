# ForexEdge environment template. Copy to .env in the repo root (the only .env) and replace every
# "change-me" with your own value. Never commit .env. Hosts and ports below are the local defaults.

# --- TimescaleDB (docker compose creates this user and database from these values) ---
DB_USER=forexedge
DB_PASS=change-me
DB_NAME=forexedge_db
DB_HOST=localhost
DB_PORT=15432
DB_LOGGING=false

# --- Redis ---
REDIS_PASS=change-me
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Kafka (KRaft, no auth locally) ---
KAFKA_BROKER=localhost:9092
KAFKAJS_NO_PARTITIONER_WARNING=1

# --- MinIO (backtest results) ---
MINIO_USER=change-me
MINIO_PASS=change-me
MINIO_ENDPOINT=localhost
MINIO_PORT=9000

# --- Grafana admin password ---
GRAFANA_PASS=change-me

# --- JWT (auth-service issues; order-service, ws-gateway, ml-service, research-agent verify) ---
# Use long random strings; the access secret must be the same for every service.
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# --- Market feed (market-service and order-service) ---
# none (default): no live feed. No prices are published, the terminal shows "No live market feed" and
#                 every order is rejected with "No live price".
# mock:           SIMULATED random prices for development only (not market data; the terminal marks them).
MARKET_FEED=none
# Development only, both strictly true/false: trade on weekends with the simulated feed.
# MOCK_STREAM_WHEN_CLOSED=false   (market-service)
# MARKET_HOURS_GATE=true          (order-service)
# Unused: no OANDA access (the OANDA provider is not wired to any MARKET_FEED value).
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
WS_GATEWAY_PORT=3005

# --- Bull Board at ws-gateway /admin/queues (not mounted unless both are set) ---
BULL_BOARD_USER=change-me
BULL_BOARD_PASS=change-me

# --- ml-service read-only DB login (created by tools/ops/create-ml-db-user.ts) ---
ML_DB_USER=forexedge_ml
ML_DB_PASS=change-me
ML_SERVICE_PORT=3006

# --- research-agent ---
# Your own free Groq API key (https://console.groq.com); only research-agent's live calls use it.
GROQ_API_KEY=
# Read-only DB login (created by tools/ops/create-research-db-user.ts)
RESEARCH_DB_USER=forexedge_research
RESEARCH_DB_PASS=change-me
# Passwords for the demo users research_demo and research_demo_2 (tools/ops/research-demo-data.ts)
RESEARCH_DEMO_PASS=change-me
RESEARCH_DEMO_2_PASS=change-me
