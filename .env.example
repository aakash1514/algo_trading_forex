# ForexEdge environment template. Copy to .env in the repo root (the only .env) and replace every
# "change-me" with your own value. Never commit .env. Hosts and ports below are the local defaults.

# --- TimescaleDB (docker compose creates this user and database from these values) ---
DB_USER=forexedge
DB_PASS=change-me
DB_NAME=forexedge_db
DB_HOST=127.0.0.1
DB_PORT=15432
DB_LOGGING=false

# --- Redis ---
REDIS_PASS=change-me
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# --- Kafka (KRaft, no auth locally) ---
KAFKA_BROKER=127.0.0.1:9092
KAFKAJS_NO_PARTITIONER_WARNING=1

# --- MinIO (backtest results) ---
MINIO_USER=change-me
MINIO_PASS=change-me
MINIO_ENDPOINT=localhost
MINIO_PORT=9000

# --- Grafana admin password ---
GRAFANA_PASS=change-me

# --- JWT (auth-service issues; order-service, ws-gateway, ml-service, research-agent verify) ---
# Use long random strings; the access secret must be the same for every service.
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# --- Market feed (market-service and order-service) ---
# none (default): no live feed. No prices are published, the terminal shows "No live market feed" and
#                 every order is rejected with "No live price".
# mock:           SIMULATED random prices for development only (not market data; the terminal marks them).
# Any other value fails startup.
MARKET_FEED=none
# Development only, both strictly true/false: trade on weekends with the simulated feed.
# MOCK_STREAM_WHEN_CLOSED=false   (market-service)
# MARKET_HOURS_GATE=true          (order-service)
# Unused: no OANDA access (the OANDA provider is not wired to any MARKET_FEED value).
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
WS_GATEWAY_PORT=3005

# --- Bull Board at ws-gateway /admin/queues (not mounted unless both are set) ---
BULL_BOARD_USER=change-me
BULL_BOARD_PASS=change-me

# --- ml-service read-only DB login (created by tools/ops/create-ml-db-user.ts) ---
ML_DB_USER=forexedge_ml
ML_DB_PASS=change-me
ML_SERVICE_PORT=3006

# --- research-agent ---
# Your own free Groq API key (https://console.groq.com); only research-agent's live calls use it.
GROQ_API_KEY=
# Read-only DB login (created by tools/ops/create-research-db-user.ts)
RESEARCH_DB_USER=forexedge_research
RESEARCH_DB_PASS=change-me
# Passwords for the demo users research_demo and research_demo_2 (tools/ops/research-demo-data.ts)
RESEARCH_DEMO_PASS=change-me
RESEARCH_DEMO_2_PASS=change-me

# --- replay-service (bar replay over the history; port 3008) ---
# Its own DB login (created by tools/ops/create-replay-db-user.ts): reads the history
# and instruments, writes only replay_* tables. Must differ from DB_USER.
REPLAY_DB_USER=forexedge_replay
REPLAY_DB_PASS=change-me
REPLAY_SERVICE_PORT=3008

# ─────────────────────────────────────────────────────────────────────────────────────────────────
# Step 7 (deployment). The services read these in development too; docs/DEPLOY.md has the full list.
# ─────────────────────────────────────────────────────────────────────────────────────────────────

# --- Accounts (auth-service) ---
# true/false. Unset means CLOSED (sign-up answers 403 and the Register link is hidden). Development
# opens it here; production leaves it false and creates demo users with tools/ops/create-demo-users.ts.
REGISTRATION_ENABLED=true
# Optional: where a visitor asks for a demo login while sign-up is closed (the login page's "Demo access"
# card links to it, e.g. a LinkedIn profile). Only an absolute https:// URL is used; anything else is
# ignored with a startup warning and the card shows "Ask the site owner for a demo login." instead.
# DEMO_REQUEST_URL=
# true/false: the refresh cookie travels over HTTPS only. Default: true when NODE_ENV=production,
# false otherwise (http://localhost). sameSite is always lax.
# COOKIE_SECURE=false

# --- CORS (every service) ---
# Comma-separated origins allowed to call the APIs with credentials. Unset in development: the local
# frontend and Grafana (localhost:4200, localhost:3001). Required when NODE_ENV=production
# (https://<domain>; the compose file sets it from DOMAIN). Never put NODE_ENV in this file.
# CORS_ORIGIN=

# --- Status dot (ws-gateway) ---
# Seconds a real (non-MOCK) tick counts as live for the terminal's "Live" dot. Default 10.
# FEED_LIVE_MAX_AGE_S=10

# --- Backtest results (ws-gateway) ---
# minio (default in development) or s3. Required when NODE_ENV=production.
# STORAGE=minio
# STORAGE=s3 uses the EC2 instance role for credentials (never keys here) and needs:
# AWS_REGION=ap-south-1
# S3_BUCKET=
# MinIO bucket name (default backtests)
# BACKTEST_BUCKET=backtests

# --- research-agent daily quota ---
# Questions per user per UTC day, counted in Redis (REDIS_*). Default 20.
# RESEARCH_DAILY_LIMIT=20

# --- Demo users (tools/ops/create-demo-users.ts; no defaults in code) ---
# Usernames, comma-separated; each needs DEMO_<USERNAME>_EMAIL and DEMO_<USERNAME>_PASS
# (at least 12 characters and the sign-up rules). In production keep these in infra/.env.demo-users.
# DEMO_USERS=demo
# DEMO_DEMO_EMAIL=
# DEMO_DEMO_PASS=

# ─────────────────────────────────────────────────────────────────────────────────────────────────
# Production (infra/.env.prod, read by docker compose --env-file; never committed). Besides the
# DB_*, REDIS_PASS, JWT_*, *_DB_USER/_PASS, MARKET_FEED, GROQ_API_KEY and STORAGE settings above:
# ─────────────────────────────────────────────────────────────────────────────────────────────────
# DOMAIN=example.com              the site's domain (Caddy serves it and redirects www.<domain>)
# IMAGE_REGISTRY=                 e.g. <account>.dkr.ecr.ap-south-1.amazonaws.com/forexedge
# IMAGE_TAG=                      the image tag to run (a git commit)
